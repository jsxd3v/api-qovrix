                  "minimum": 0,
                  "type": "number"
                }
              ],
              "description": "Duration, e.g. '500ms', '10s', '1m', '2h' (a number means seconds)."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Remind while still down, e.g. '1h' (serve).",
          "title": "Alert Repeat"
